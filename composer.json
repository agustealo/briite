{
  "name": "agustealo/briite",
  "description": "Development tooling for the Briite classic WordPress theme.",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpcompatibility/phpcompatibility-wp": "2.1.8",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "3.4.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": [
      "phpcs --standard=phpcs.xml.dist .",
      "@local-assets",
      "@template-contracts"
    ],
    "local-assets": "php tools/check-local-assets.php",
    "template-contracts": "php tools/check-template-contracts.php",
    "phpcompat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 7.4-8.5 --extensions=php --ignore=vendor ."
  }
}
