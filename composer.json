{
  "name": "agustealo/briite",
  "description": "Development tooling for the Briite classic WordPress theme.",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpcompatibility/phpcompatibility-wp": "2.1.8",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "3.4.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": [
      "phpcs --standard=phpcs.xml.dist .",
      "@local-assets",
      "@template-contracts",
      "@integration-contracts",
      "@theme-scope-contracts",
      "@text-domain-contract",
      "@package:wordpress-org"
    ],
    "local-assets": "php tools/check-local-assets.php",
    "template-contracts": "php tools/check-template-contracts.php",
    "integration-contracts": "php tools/check-integration-contracts.php",
    "theme-scope-contracts": "php tools/check-theme-scope-contracts.php",
    "text-domain-contract": "bash tools/check-text-domain-contract.sh",
    "phpcompat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 7.4-8.5 --extensions=php --ignore=vendor .",
    "package": "bash tools/build-release.sh",
    "package:wordpress-org": "bash tools/build-wordpress-org-release.sh"
  }
}
