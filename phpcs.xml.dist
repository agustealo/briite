<?xml version="1.0"?>
<ruleset name="Briite">
	<description>WordPress coding standards for the Briite theme.</description>

	<file>.</file>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="extensions" value="php"/>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/.git/*</exclude-pattern>

	<config name="minimum_supported_wp_version" value="5.9"/>

	<rule ref="WordPress">
		<exclude name="WordPress.NamingConventions.ValidFunctionName.FunctionNameInvalid"/>
	</rule>

	<!-- Canonical Briite code uses only Briite's current and historical theme prefixes. Generic historical globals are narrowly suppressed in their isolated consumer-compatibility module. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="briite"/>
				<element value="kriate"/>
			</property>
		</properties>
	</rule>

	<!-- WPCS 3.4.1 misclassifies the documented compatibility-only include wrapper as lacking a file comment. Keep every other sniff active on that file. -->
	<rule ref="Squiz.Commenting.FileComment.Missing">
		<exclude-pattern>inc/profile.php</exclude-pattern>
	</rule>
</ruleset>
